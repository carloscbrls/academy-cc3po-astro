---
// The application — native, 3 steps, on the Village spine
// (cc3po-ops Supabase, table academy_applications). Rebuilt under
// Carlos's forms ruling (2026-11-24: CC3PO's own sites use native
// forms on our Supabase spine; Netlify/Jotform forms retire) and the
// Nov 24 funnel spec: Step 1 writes the lead the moment it's
// completed, so an abandoned application is still captured.
//
// Step-1 persistence pattern: completing Step 1 inserts a 'started'
// snapshot keyed by a client-generated application_id; the final
// submit inserts the 'submitted' snapshot with the full payload.
// Anon INSERT only (RLS + CHECK constraints validate server-side).
//
// DEPOSIT: ruled ON by Carlos 2026-11-25 (deck model: free attendance
// + a $10–$25 commitment deposit, refunded on attendance). Step 3
// carries the deposit panel + a required acknowledgment. Collection
// runs through the Stripe Payment Link in src/config/academy.mjs —
// until that link is configured, submissions land with
// deposit_status 'pending-config' and the acknowledgment on record.
import { spine, deposit } from '../config/academy.mjs';

export interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';

const s = es
  ? {
      heading: 'Solicita un lugar',
      sub: 'Veinte lugares. Las solicitudes las lee una persona. Buscamos gente que está construyendo o dirigiendo algo — no gente coleccionando certificados.',
      noteFreeT: 'Gratis asistir.',
      noteFree: `Cada sesión, durante todo el año. Un depósito de compromiso de ${deposit.rangeLabel} asegura tu lugar — y se te reembolsa cuando asistes.`,
      noteCappedT: 'Limitado.',
      noteCapped: 'Veinte lugares por sesión. Un salón pequeño donde todos construyen algo supera a un salón grande donde nadie lo hace.',
      noteMonthlyT: 'Una vez al mes al principio.',
      noteMonthly: 'Sesiones de dos horas, en la tarde-noche, en Stockton. Ven a una y mira si es para ti — sin compromiso. Las sesiones 1–6 son mensuales para que haya tiempo de construir entre ellas; pasamos a dos veces al mes cuando el grupo se consolide.',
      stepOf: 'de',
      steps: ['Sobre ti', 'Lo que estás construyendo', 'Detalles finales'],
      name: 'Tu nombre *', namePh: 'Nombre y apellido',
      email: 'Correo electrónico *',
      phone: 'Teléfono', phoneOpt: '(opcional — solo se usa si necesitamos contactarte sobre tu solicitud)', phonePh: 'Opcional',
      city: 'Ciudad', cityPh: 'Stockton, Modesto, Lathrop…',
      role: '¿A qué te dedicas? *', pick: 'Elige una…',
      roles: ['Dueño/a u operador/a de negocio', 'Marketing, ventas o atención al cliente', 'TI, administración de sistemas o soporte técnico', 'Desarrollador/a / ingeniero/a', 'Salud, legal o finanzas', 'Educación, sin fines de lucro o sector público', 'Estudiante o en cambio de carrera', 'Otra cosa'],
      building: '¿Qué estás construyendo o dirigiendo ahora mismo? *',
      buildingHint: 'Esta es la pregunta que decide. Responde con honestidad — «Estoy tratando de automatizar mi facturación» supera a «Quiero aprender IA».',
      buildingPh: 'Unas pocas frases son suficientes.',
      goal: '¿Qué te encantaría tener funcionando al final del año? *', goalPh: 'Eso que te enorgullecería mostrarle a alguien.',
      coding: 'Tu comodidad con el código *',
      codingOpts: ['Ninguna — nunca he escrito código', 'Un poco — puedo seguir código, no escribirlo', 'Cómoda — escribo código con regularidad', 'Avanzada — construyo sistemas en producción'],
      track: '¿Cuál salón suena como el tuyo? *',
      trackOpts: [
        { v: 'operator', label: 'Operator — cero código (n8n, Make, Dify, Sheets)' },
        { v: 'builder', label: 'Builder — quiero escribir el código (Python, FastAPI, Docker, GitHub)' },
        { v: 'not-sure', label: 'Todavía no lo sé — ubíquenme ustedes' },
      ],
      laptop: '¿Tienes una computadora portátil donde puedas instalar software?',
      laptopOpts: ['Sí — puedo instalar lo que sea', 'Solo navegador — mi laptop está bloqueada', 'Necesitaría pedir una prestada'],
      expect: '¿Qué haría que estas dos horas valieran la pena?', expectPh: 'Opcional — pero es el campo más útil de este formulario.',
      link: 'Enlace a algo que hayas hecho (sitio, GitHub, LinkedIn)', linkPh: 'Opcional',
      depositTitle: 'El depósito de compromiso',
      depositBody: `Asistir es gratis. Para apartar uno de los ${20} lugares, pedimos un depósito de compromiso de ${deposit.rangeLabel}. Se te reembolsa cuando asistes — está para que el lugar sea real, no para que cueste.`,
      depositAck: `Entiendo que un depósito reembolsable de ${deposit.rangeLabel} asegura mi lugar y se reembolsa cuando asista.`,
      commitment: 'Puedo comprometerme a <strong>una sesión al mes</strong> y traeré mi propio problema para trabajarlo.',
      submit: 'Solicitar un lugar',
      fineprint: 'Te escribiremos en una semana, sea cual sea la respuesta. Si no encajamos, te lo diremos — y te recomendaremos algo mejor si conocemos alguna opción. Al solicitar aceptas nuestro <a href="/code-of-conduct">código de conducta</a> y nuestro <a href="/privacy">aviso de privacidad</a>.',
      back: 'Atrás', next: 'Continuar',
      sending: 'Enviando…',
      error: 'Algo salió mal al enviar. Tus respuestas siguen aquí — inténtalo de nuevo, o llámanos al 209-701-1137.',
    }
  : {
      heading: 'Apply for a seat',
      sub: "Twenty seats. Applications are read by a human. We want people who are building or running something — not people collecting certificates.",
      noteFreeT: 'Free to attend.',
      noteFree: `Every session, for the full year. A ${deposit.rangeLabel} commitment deposit holds your seat — refunded when you attend.`,
      noteCappedT: 'Capped.',
      noteCapped: 'Twenty seats per session. A small room where everyone ships something beats a big room where nobody does.',
      noteMonthlyT: 'Monthly to start.',
      noteMonthly: "Two-hour sessions, evenings, in Stockton. Come to one and see if it's for you — no obligation. Sessions 1–6 run monthly so there is time to build between them; we go twice monthly once the room holds.",
      stepOf: 'of',
      steps: ['About you', "What you're building", 'Final details'],
      name: 'Your name *', namePh: 'First and last',
      email: 'Email *',
      phone: 'Phone', phoneOpt: '(optional — only used if we need to reach you about your application)', phonePh: 'Optional',
      city: 'City', cityPh: 'Stockton, Modesto, Lathrop…',
      role: 'What do you do? *', pick: 'Pick one…',
      roles: ['Business owner / operator', 'Marketing, sales, or customer success', 'IT, sysadmin, or technical support', 'Developer / engineer', 'Healthcare, legal, or finance', 'Education, nonprofit, or public sector', 'Student or career-changer', 'Something else'],
      building: 'What are you building or running right now? *',
      buildingHint: 'This is the screening question. Answer honestly — "I\'m trying to automate my invoicing" beats "I want to learn AI."',
      buildingPh: 'A few sentences is plenty.',
      goal: 'What would you love to have working by the end of the year? *', goalPh: "The thing you'd be proud to show someone.",
      coding: 'Your coding comfort *',
      codingOpts: ["None — I've never written code", 'A little — I can follow code, not write it', 'Comfortable — I write code regularly', 'Advanced — I build production systems'],
      track: 'Which room sounds like yours? *',
      trackOpts: [
        { v: 'operator', label: 'Operator — zero code (n8n, Make, Dify, Sheets)' },
        { v: 'builder', label: 'Builder — I want to write the code (Python, FastAPI, Docker, GitHub)' },
        { v: 'not-sure', label: "Not sure yet — place me" },
      ],
      laptop: 'Do you have a laptop you can install software on?',
      laptopOpts: ['Yes — I can install anything', 'Browser only — my laptop is locked down', "I'd need to borrow one"],
      expect: 'What would make this worth your two hours?', expectPh: "Optional — but it's the most useful box on this form.",
      link: 'Link to something you made (site, GitHub, LinkedIn)', linkPh: 'Optional',
      depositTitle: 'The commitment deposit',
      depositBody: `Attendance is free. To hold one of the 20 seats, we ask for a commitment deposit of ${deposit.rangeLabel}. It's refunded when you attend — it's there so the seat is real, not so the seat costs money.`,
      depositAck: `I understand a refundable commitment deposit (${deposit.rangeLabel}) holds my seat and is refunded on attendance.`,
      commitment: "I can commit to <strong>a session a month</strong> and I'll bring my own problem to work on.",
      submit: 'Apply for a seat',
      fineprint: "We'll email you within a week either way. If we're not a fit, we'll tell you — and point you at something better if we know of it. By applying you agree to our <a href=\"/code-of-conduct\">code of conduct</a> and <a href=\"/privacy\">privacy notice</a>.",
      back: 'Back', next: 'Continue',
      sending: 'Sending…',
      error: "Something went wrong sending that. Your answers are still here — try again, or call us at 209-701-1137.",
    };
---

<section class="apply" id="apply">
  <div class="container">
    <div class="apply-head">
      <h2>{s.heading}</h2>
      <p class="section-sub">{s.sub}</p>
      <div class="notes">
        <div class="note"><strong>{s.noteFreeT}</strong> {s.noteFree}</div>
        <div class="note"><strong>{s.noteCappedT}</strong> {s.noteCapped}</div>
        <div class="note"><strong>{s.noteMonthlyT}</strong> {s.noteMonthly}</div>
      </div>
    </div>

    <form
      class="form"
      id="application-form"
      novalidate
      data-lang={lang}
      data-spine-url={spine.url}
      data-spine-key={spine.anonKey}
      data-deposit-link={deposit.stripePaymentLink}
    >
      <p class="hidden" aria-hidden="true">
        <label>Leave this empty: <input name="company" tabindex="-1" autocomplete="off" /></label>
      </p>

      <p class="step-indicator" aria-live="polite">Step <span id="step-current">1</span> {s.stepOf} 3 — <span id="step-name">{s.steps[0]}</span></p>

      <fieldset class="step" data-step="1">
        <legend>{s.steps[0]}</legend>
        <div class="field">
          <label for="app-name">{s.name}</label>
          <input id="app-name" type="text" name="name" required placeholder={s.namePh} autocomplete="name" />
        </div>
        <div class="field">
          <label for="app-email">{s.email}</label>
          <input id="app-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
        </div>
        <div class="field">
          <label for="app-phone">{s.phone} <span class="optional">{s.phoneOpt}</span></label>
          <input id="app-phone" type="tel" name="phone" placeholder={s.phonePh} autocomplete="tel" />
        </div>
        <div class="field">
          <label for="app-city">{s.city}</label>
          <input id="app-city" type="text" name="city" placeholder={s.cityPh} autocomplete="address-level2" />
        </div>
      </fieldset>

      <fieldset class="step" data-step="2" hidden>
        <legend>{s.steps[1]}</legend>
        <div class="field">
          <label for="app-role">{s.role}</label>
          <select id="app-role" name="role" required>
            <option value="">{s.pick}</option>
            {s.roles.map((r) => <option>{r}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="app-building">{s.building}<em class="hint">{s.buildingHint}</em></label>
          <textarea id="app-building" name="building" rows="4" required placeholder={s.buildingPh}></textarea>
        </div>
        <div class="field">
          <label for="app-goal">{s.goal}</label>
          <textarea id="app-goal" name="goal" rows="3" required placeholder={s.goalPh}></textarea>
        </div>
        <div class="field">
          <label for="app-coding">{s.coding}</label>
          <select id="app-coding" name="coding" required>
            <option value="">{s.pick}</option>
            {s.codingOpts.map((r) => <option>{r}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="app-track">{s.track}</label>
          <select id="app-track" name="track" required>
            <option value="">{s.pick}</option>
            {s.trackOpts.map((r) => <option value={r.v}>{r.label}</option>)}
          </select>
        </div>
      </fieldset>

      <fieldset class="step" data-step="3" hidden>
        <legend>{s.steps[2]}</legend>
        <div class="field">
          <label for="app-laptop">{s.laptop}</label>
          <select id="app-laptop" name="laptop">
            <option value="">{s.pick}</option>
            {s.laptopOpts.map((r) => <option>{r}</option>)}
          </select>
        </div>
        <div class="field">
          <label for="app-expect">{s.expect}</label>
          <textarea id="app-expect" name="expect" rows="3" placeholder={s.expectPh}></textarea>
        </div>
        <div class="field">
          <label for="app-link">{s.link}</label>
          <input id="app-link" type="url" name="link" placeholder={s.linkPh} />
        </div>

        <div class="deposit-panel">
          <h3>{s.depositTitle}</h3>
          <p>{s.depositBody}</p>
          <div class="check">
            <input id="app-deposit-ack" type="checkbox" name="deposit_ack" required />
            <label for="app-deposit-ack">{s.depositAck}</label>
          </div>
        </div>

        <div class="check">
          <input id="app-commitment" type="checkbox" name="commitment" required />
          <label for="app-commitment" set:html={s.commitment}></label>
        </div>

        <p class="form-error" id="form-error" role="alert" hidden>{s.error}</p>
        <button type="submit" class="submit" id="app-submit">{s.submit}</button>
        <p class="fineprint" set:html={s.fineprint}></p>
      </fieldset>

      <div class="step-nav">
        <button type="button" class="nav-btn secondary" id="step-back" hidden>{s.back}</button>
        <button type="button" class="nav-btn" id="step-next">{s.next}</button>
      </div>
    </form>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('application-form');
    if (!form) return;
    var SPINE_URL = form.getAttribute('data-spine-url');
    var SPINE_KEY = form.getAttribute('data-spine-key');
    var DEPOSIT_LINK = form.getAttribute('data-deposit-link') || '';
    var LANG = form.getAttribute('data-lang') || 'en';
    var SUCCESS_HREF = LANG === 'es' ? '/es/success' : '/success';
    // Track pages link here with ?track=operator|builder — preselect.
    try {
      var wanted = new URLSearchParams(window.location.search).get('track');
      if (wanted === 'operator' || wanted === 'builder') {
        var trackSel = form.querySelector('[name="track"]');
        if (trackSel) trackSel.value = wanted;
      }
    } catch (e) { /* no-op */ }
    var steps = Array.prototype.slice.call(form.querySelectorAll('.step'));
    var back = document.getElementById('step-back');
    var next = document.getElementById('step-next');
    var currentEl = document.getElementById('step-current');
    var nameEl = document.getElementById('step-name');
    var errorEl = document.getElementById('form-error');
    var submitBtn = document.getElementById('app-submit');
    var names = steps.map(function (st) { return st.querySelector('legend').textContent; });
    var current = 0;
    var applicationId = null;
    var startedWritten = false;

    function uuid() {
      if (window.crypto && crypto.randomUUID) return crypto.randomUUID();
      return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function (c) {
        var r = (Math.random() * 16) | 0;
        var v = c === 'x' ? r : (r & 0x3) | 0x8;
        return v.toString(16);
      });
    }
    function val(name) {
      var el = form.querySelector('[name="' + name + '"]');
      if (!el) return null;
      if (el.type === 'checkbox') return el.checked;
      var v = (el.value || '').trim();
      return v === '' ? null : v;
    }
    function post(row) {
      return fetch(SPINE_URL + '/rest/v1/academy_applications', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ['api' + 'key']: SPINE_KEY,
          Authorization: 'Bearer ' + SPINE_KEY,
          Prefer: 'return=minimal',
        },
        body: JSON.stringify(row),
        keepalive: true,
      }).then(function (res) { return res.ok; }).catch(function () { return false; });
    }
    function writeStarted() {
      if (startedWritten) return;
      startedWritten = true;
      if (!applicationId) applicationId = uuid();
      post({
        application_id: applicationId,
        kind: 'started',
        name: val('name'),
        email: val('email'),
        phone: val('phone'),
        city: val('city'),
        lang: LANG,
      });
    }
    function show(i) {
      current = i;
      steps.forEach(function (st, idx) { st.hidden = idx !== i; });
      back.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      currentEl.textContent = String(i + 1);
      nameEl.textContent = names[i];
      var first = steps[i].querySelector('input, select, textarea');
      if (first) first.focus({ preventScroll: false });
    }
    function stepValid(i) {
      var fields = steps[i].querySelectorAll('input, select, textarea');
      for (var k = 0; k < fields.length; k++) {
        if (!fields[k].checkValidity()) { fields[k].reportValidity(); return false; }
      }
      return true;
    }
    next.addEventListener('click', function () {
      if (!stepValid(current)) return;
      if (current === 0) writeStarted();
      if (current < steps.length - 1) show(current + 1);
    });
    back.addEventListener('click', function () {
      if (current > 0) show(current - 1);
    });
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      for (var i = 0; i < steps.length; i++) {
        var fields = steps[i].querySelectorAll('input, select, textarea');
        for (var k = 0; k < fields.length; k++) {
          if (!fields[k].checkValidity()) {
            show(i);
            fields[k].reportValidity();
            return;
          }
        }
      }
      // Honeypot: a filled company field means a bot — fake success.
      if (val('company')) { window.location.href = SUCCESS_HREF; return; }
      if (!applicationId) applicationId = uuid();
      errorEl.hidden = true;
      submitBtn.disabled = true;
      var sending = submitBtn.getAttribute('data-sending');
      if (sending) submitBtn.textContent = sending;
      post({
        application_id: applicationId,
        kind: 'submitted',
        name: val('name'),
        email: val('email'),
        phone: val('phone'),
        city: val('city'),
        role: val('role'),
        building: val('building'),
        goal: val('goal'),
        coding: val('coding'),
        track: val('track'),
        laptop: val('laptop'),
        expect: val('expect'),
        link: val('link'),
        commitment: val('commitment') === true,
        deposit_acknowledged: val('deposit_ack') === true,
        deposit_status: DEPOSIT_LINK ? 'link-sent' : 'pending-config',
        lang: LANG,
      }).then(function (ok) {
        if (!ok) {
          submitBtn.disabled = false;
          submitBtn.textContent = submitBtn.getAttribute('data-label') || submitBtn.textContent;
          errorEl.hidden = false;
          errorEl.scrollIntoView({ block: 'center' });
          return;
        }
        if (DEPOSIT_LINK) { window.location.href = DEPOSIT_LINK; return; }
        window.location.href = SUCCESS_HREF;
      });
    });
    submitBtn.setAttribute('data-label', submitBtn.textContent);
    submitBtn.setAttribute('data-sending', LANG === 'es' ? 'Enviando…' : 'Sending…');
  })();
</script>

<style>
  .apply { padding: 70px 0 80px; }
  .apply-head { max-width: 760px; margin-bottom: 40px; }
  h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); font-weight: 800; letter-spacing: -0.02em; }
  .section-sub { color: var(--text-muted); margin: 14px 0 26px; }
  .notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .note {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 16px 18px;
    color: var(--text-muted); font-size: 0.9rem;
  }
  .note strong { color: var(--accent); }
  .form {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 32px; max-width: 820px;
  }
  .step-indicator { color: var(--text-dim); font-size: 0.88rem; font-weight: 600; margin-bottom: 18px; }
  fieldset.step { border: 0; padding: 0; margin: 0; min-width: 0; }
  fieldset.step legend {
    font-size: 1.15rem; font-weight: 700; margin-bottom: 18px; padding: 0;
  }
  .field { display: block; margin-bottom: 20px; }
  .field label {
    display: block; font-size: 0.88rem; font-weight: 600;
    margin-bottom: 7px; color: var(--text);
  }
  .optional { font-weight: 400; color: var(--text-dim); font-size: 0.82rem; }
  .hint {
    display: block; font-style: normal; font-weight: 400;
    color: var(--text-dim); font-size: 0.82rem; margin-top: 4px;
  }
  input[type='text'], input[type='email'], input[type='tel'], input[type='url'], select, textarea {
    width: 100%; background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 14px; color: var(--text);
    font-family: inherit; font-size: 1rem; transition: border-color .15s;
  }
  textarea { resize: vertical; line-height: 1.55; }
  input:focus, select:focus, textarea:focus {
    outline: none; border-color: var(--focus);
    box-shadow: 0 0 0 1px var(--focus);
  }
  select { cursor: pointer; }
  .check {
    display: flex; gap: 12px; align-items: flex-start;
    margin: 26px 0 22px; font-size: 0.92rem; color: var(--text-muted);
  }
  .check input { margin-top: 3px; accent-color: var(--accent-strong); width: 20px; height: 20px; flex: none; }
  .check label { cursor: pointer; padding: 10px 0; margin: -10px 0; }
  .check strong { color: var(--text); }
  .deposit-panel {
    border: 1px solid var(--border-accent); border-radius: var(--radius);
    padding: 22px; margin: 28px 0 6px;
    background: color-mix(in srgb, var(--brand-accent) 6%, var(--brand-surface-dark));
  }
  .deposit-panel h3 { font-size: 1.05rem; font-weight: 700; margin: 0 0 8px; }
  .deposit-panel p { color: var(--text-muted); font-size: 0.94rem; margin: 0; }
  .deposit-panel .check { margin: 18px 0 0; }
  .form-error {
    background: var(--semantic-danger-surface); color: var(--accent-tint);
    border: 1px solid var(--semantic-danger); border-radius: 8px;
    padding: 12px 16px; font-size: 0.92rem; margin: 18px 0;
  }
  .submit {
    background: var(--accent-strong); color: var(--brand-paper); border: 0;
    font-weight: 700; font-size: 1rem; padding: 15px 36px;
    border-radius: 999px; cursor: pointer; font-family: inherit;
    transition: background .2s; min-height: 52px;
  }
  .submit:hover { background: var(--accent-strong); box-shadow: 0 0 0 2px var(--accent-hover); }
  .submit:disabled { opacity: 0.6; cursor: wait; }
  .step-nav { display: flex; gap: 12px; margin-top: 24px; }
  .nav-btn {
    background: var(--accent-strong); color: var(--brand-paper); border: 0;
    font-weight: 700; font-size: 0.95rem; padding: 13px 30px;
    border-radius: 999px; cursor: pointer; font-family: inherit;
    transition: background .2s; min-height: 48px;
  }
  .nav-btn:hover { background: var(--accent-strong); box-shadow: 0 0 0 2px var(--accent-hover); }
  .nav-btn.secondary {
    background: transparent; color: var(--text);
    border: 1px solid var(--border);
  }
  .nav-btn.secondary:hover { background: var(--bg-card-hover); border-color: var(--border-accent); }
  .fineprint { color: var(--text-dim); font-size: 0.84rem; margin: 16px 0 0; }
  .fineprint a { color: var(--text-muted); text-decoration: underline; }
  /* Honeypot: off-screen but not display:none, so bots still fill it. */
  .hidden {
    position: absolute; left: -5000px; top: auto;
    width: 1px; height: 1px; overflow: hidden;
  }
  .hidden input { font-size: 1rem; }
  @media (max-width: 640px) {
    .form { padding: 22px; }
  }
</style>
