---
import SupportNote from './SupportNote.astro';
export interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
---
<footer class="footer">
  <div class="container">
    <div class="row">
      <div class="brand">
        <div class="logo">CC3PO <span>AI Builders</span></div>
        <p>{es ? 'De los primeros principios a los sistemas en producción. Se imparte en Stockton, California.' : 'From first principles to shipped systems. Taught in Stockton, California.'}</p>
      </div>
      <div class="links">
        <a href={es ? '/es/cohort' : '/cohort'}>{es ? 'Cohorte' : 'Cohort'}</a>
        <a href={es ? '/es/apply' : '/apply'}>{es ? 'Solicitar' : 'Apply'}</a>
        <a href={es ? '/demo-day' : '/demo-day'}>Demo Day</a>
        <a href={es ? '/partners' : '/partners'}>{es ? 'Empleadores y socios' : 'Employers & partners'}</a>
        <a href="https://cc3po.com">cc3po.com</a>
        <a href="https://github.com/carloscbrls/cc3po-ai-q1-foundations">{es ? 'Repositorios de la clase' : 'Class repos'}</a>
        <a href="/code-of-conduct">{es ? 'Código de conducta' : 'Code of conduct'}</a>
        <a href="/privacy">{es ? 'Privacidad' : 'Privacy'}</a>
        <a href="tel:+12097011137">209-701-1137</a>
      </div>
    </div>
    <SupportNote lang={lang} />
    <div class="copy">&copy; {new Date().getFullYear()} CC3PO LLC. Se habla espa&ntilde;ol.</div>
  </div>
</footer>
<style>
  .footer { border-top: 1px solid var(--border); padding: 40px 0 24px; }
  .row { display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 24px; }
  .brand .logo { font-weight: 800; font-size: 1.1rem; }
  .brand .logo span { color: var(--accent); }
  .brand p { color: var(--text-dim); margin-top: 6px; font-size: 0.85rem; }
  .links { display: flex; gap: 20px; flex-wrap: wrap; max-width: 560px; }
  .links a { color: var(--text-muted); font-size: 0.85rem; transition: color 0.2s; padding: 6px 0; }
  .links a:hover { color: var(--accent); }
  .copy { color: var(--text-dim); font-size: 0.8rem; margin-top: 32px; padding-top: 16px; border-top: 1px solid var(--border); }
</style>
