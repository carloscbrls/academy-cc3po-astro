---
// Post-submit confirmation body — shared by /success and /es/success.
// Copy verbatim from the pre-Shift-Change success page (EN); the ES
// rendering is an in-house draft translation for Carlos's review.
export interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
const base = es ? '/es' : '';
---
<div class="container wrap">
  <div class="badge">{es ? 'Solicitud recibida' : 'Application received'}</div>
  <h1>{es ? 'Ya estás en la lista.' : "You're in the queue."}</h1>
  <p class="lead">
    {es
      ? 'Gracias por solicitar. Cada solicitud la lee una persona — no la puntúa un filtro. Si encajamos, te escribiremos en una semana con la fecha y la dirección.'
      : "Thanks for applying. Every application is read by a human — not scored by a filter. If we're a fit, you'll hear from us within a week with the date and the address."}
  </p>
  <p class="lead">
    {es
      ? 'Y si no encajamos, también te lo diremos, y te señalaremos algo mejor si conocemos una opción.'
      : "If we're not a fit, you'll hear that too, and we'll point you at something better if we know of one."}
  </p>
  <div class="actions">
    <a class="cta" href={`${base}/#curriculum`}>{es ? 'Ver las 24 sesiones' : 'See the 24 sessions'}</a>
    <a class="cta secondary" href={base || '/'}>{es ? 'Volver al programa' : 'Back to the program'}</a>
  </div>
</div>
<style>
  .wrap { padding: 90px 0 60px; max-width: 640px; }
  .badge {
    display: inline-block; background: var(--accent-mist); color: var(--accent);
    border: 1px solid var(--border-accent); border-radius: 999px;
    padding: 6px 16px; font-size: 0.8rem; font-weight: 600; margin-bottom: 22px;
  }
  h1 { font-size: clamp(2rem, 5vw, 3rem); font-weight: 800; letter-spacing: -0.02em; }
  .lead { color: var(--text-muted); font-size: 1.05rem; margin: 18px 0; line-height: 1.65; }
  .actions { display: flex; gap: 14px; margin-top: 34px; flex-wrap: wrap; }
  .cta {
    display: inline-block; background: var(--accent-strong); color: var(--brand-paper); font-weight: 700;
    padding: 13px 28px; border-radius: 999px; font-size: 0.95rem; min-height: 48px;
  }
  .cta:hover { background: var(--accent-strong); box-shadow: 0 0 0 2px var(--accent-hover); }
  .cta.secondary { background: transparent; color: var(--text); border: 1px solid var(--border); }
  .cta.secondary:hover { background: var(--bg-card-hover); }
</style>
