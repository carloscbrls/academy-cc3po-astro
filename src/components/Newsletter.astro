---
const FORM_ACTION = 'https://formsubmit.co/legal@cc3po.com';
---

<section class="apply" id="apply">
  <div class="container">
    <div class="apply-head">
      <h2>Apply for a seat</h2>
      <p class="section-sub">
        Twenty seats. Applications are read by a human. We want people who are
        building or running something — not people collecting certificates.
      </p>
      <div class="notes">
        <div class="note">
          <strong>Free.</strong> Every session, for the full year. The paid
          cohort that follows is optional and separate.
        </div>
        <div class="note">
          <strong>Capped.</strong> Twenty seats per session. A small room where
          everyone ships something beats a big room where nobody does.
        </div>
        <div class="note">
          <strong>Twice monthly.</strong> Two-hour sessions, evenings, in
          Stockton. Come to one and see if it's for you — no obligation.
        </div>
      </div>
    </div>

    <form class="form" action={FORM_ACTION} method="POST">
      <input type="hidden" name="_subject" value="CC3PO AI Builders — application" />
      <input type="hidden" name="_captcha" value="false" />
      <input type="hidden" name="_template" value="table" />
      <input type="hidden" name="_next" value="https://academy.cc3po.com/?applied=1" />

      <div class="row">
        <label class="field">
          <span class="label">Your name *</span>
          <input type="text" name="name" required placeholder="First and last" />
        </label>
        <label class="field">
          <span class="label">Email *</span>
          <input type="email" name="email" required placeholder="you@example.com" />
        </label>
      </div>

      <div class="row">
        <label class="field">
          <span class="label">Phone</span>
          <input type="tel" name="phone" placeholder="Optional" />
        </label>
        <label class="field">
          <span class="label">City</span>
          <input type="text" name="city" placeholder="Stockton, Modesto, Lathrop…" />
        </label>
      </div>

      <label class="field">
        <span class="label">What do you do? *</span>
        <select name="role" required>
          <option value="">Pick one…</option>
          <option>Business owner / operator</option>
          <option>Marketing, sales, or customer success</option>
          <option>IT, sysadmin, or technical support</option>
          <option>Developer / engineer</option>
          <option>Healthcare, legal, or finance</option>
          <option>Education, nonprofit, or public sector</option>
          <option>Student or career-changer</option>
          <option>Something else</option>
        </select>
      </label>

      <label class="field">
        <span class="label">
          What are you building or running right now? *
          <em class="hint">This is the screening question. Answer honestly — "I'm trying to automate my invoicing" beats "I want to learn AI."</em>
        </span>
        <textarea name="building" rows="4" required placeholder="A few sentences is plenty."></textarea>
      </label>

      <label class="field">
        <span class="label">
          What would you love to have working by the end of the year? *
        </span>
        <textarea name="goal" rows="3" required placeholder="The thing you'd be proud to show someone."></textarea>
      </label>

      <div class="row">
        <label class="field">
          <span class="label">Your coding comfort *</span>
          <select name="coding" required>
            <option value="">Pick one…</option>
            <option>None — I've never written code</option>
            <option>A little — I can follow code, not write it</option>
            <option>Comfortable — I write code regularly</option>
            <option>Advanced — I build production systems</option>
          </select>
        </label>
        <label class="field">
          <span class="label">Do you have a laptop you can install software on?</span>
          <select name="laptop">
            <option value="">Pick one…</option>
            <option>Yes — I can install anything</option>
            <option>Browser only — my laptop is locked down</option>
            <option>I'd need to borrow one</option>
          </select>
        </label>
      </div>

      <label class="field">
        <span class="label">What would make this worth your two hours?</span>
        <textarea name="expect" rows="3" placeholder="Optional — but it's the most useful box on this form."></textarea>
      </label>

      <label class="field">
        <span class="label">Link to something you made (site, GitHub, LinkedIn)</span>
        <input type="url" name="link" placeholder="Optional" />
      </label>

      <label class="check">
        <input type="checkbox" name="commitment" required />
        <span>
          I can commit to <strong>two sessions a month</strong> and I'll bring
          my own problem to work on.
        </span>
      </label>

      <button type="submit" class="submit">Apply for a seat</button>
      <p class="fineprint">
        We'll email you within a week either way. If we're not a fit, we'll
        tell you — and point you at something better if we know of it.
      </p>
    </form>
  </div>
</section>

<style>
  .apply { padding: 70px 0 80px; }
  .apply-head { max-width: 760px; margin-bottom: 40px; }
  h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); font-weight: 800; letter-spacing: -0.02em; }
  .section-sub { color: var(--text-muted); margin: 14px 0 26px; }
  .notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .note {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 16px 18px;
    color: var(--text-muted); font-size: 0.9rem;
  }
  .note strong { color: var(--accent); }
  .form {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 32px; max-width: 820px;
  }
  .row { display: grid; grid-template-columns: 1fr 1fr; gap: 18px; }
  .field { display: block; margin-bottom: 20px; }
  .label {
    display: block; font-size: 0.88rem; font-weight: 600;
    margin-bottom: 7px; color: var(--text);
  }
  .hint {
    display: block; font-style: normal; font-weight: 400;
    color: var(--text-dim); font-size: 0.82rem; margin-top: 4px;
  }
  input[type='text'], input[type='email'], input[type='tel'], input[type='url'], select, textarea {
    width: 100%; background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 14px; color: var(--text);
    font-family: inherit; font-size: 0.95rem; transition: border-color .15s;
  }
  textarea { resize: vertical; line-height: 1.55; }
  input:focus, select:focus, textarea:focus {
    outline: none; border-color: var(--accent);
  }
  select { cursor: pointer; }
  .check {
    display: flex; gap: 12px; align-items: flex-start;
    margin: 26px 0 22px; font-size: 0.92rem; color: var(--text-muted);
    cursor: pointer;
  }
  .check input { margin-top: 3px; accent-color: var(--accent); width: 17px; height: 17px; }
  .check strong { color: var(--text); }
  .submit {
    background: var(--accent); color: #000; border: 0;
    font-weight: 700; font-size: 1rem; padding: 15px 36px;
    border-radius: 999px; cursor: pointer; font-family: inherit;
    transition: background .2s;
  }
  .submit:hover { background: var(--accent-hover); }
  .fineprint { color: var(--text-dim); font-size: 0.84rem; margin: 16px 0 0; }
  @media (max-width: 640px) {
    .row { grid-template-columns: 1fr; }
    .form { padding: 22px; }
  }
</style>
