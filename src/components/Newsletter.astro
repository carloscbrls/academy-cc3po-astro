---
// Netlify Forms. `netlify` + `name` are required for the build to detect
// the form. Submissions land in the Netlify dashboard (and can be emailed
// to legal@cc3po.com). This replaced formsubmit.co, which was returning
// 522 and would have silently dropped every application.
//
// 2026-11-24: rebuilt as a 3-step form (single column). The submission is
// unchanged — one Netlify Forms POST with the same field names, sent when
// the applicant finishes Step 3. NOTE: this form does NOT write to
// Supabase; the research plan's "Step 1 writes the lead to Supabase
// immediately" step is not implemented because the existing form backend
// is Netlify Forms only and there is no Supabase write pattern in this
// repo to copy.
const FORM_ACTION = '/';
---

<section class="apply" id="apply">
  <div class="container">
    <div class="apply-head">
      <h2>Apply for a seat</h2>
      <p class="section-sub">
        Twenty seats. Applications are read by a human. We want people who are
        building or running something — not people collecting certificates.
      </p>
      <div class="notes">
        <div class="note">
          <strong>Free.</strong> Every session, for the full year. The paid
          cohort that follows is optional and separate.
        </div>
        <div class="note">
          <strong>Capped.</strong> Twenty seats per session. A small room where
          everyone ships something beats a big room where nobody does.
        </div>
        <div class="note">
          <strong>Monthly to start.</strong> Two-hour sessions, evenings, in
          Stockton. Come to one and see if it's for you — no obligation.
          Sessions 1–6 run monthly so there is time to build between them;
          we go twice monthly once the room holds.
        </div>
      </div>
    </div>

    <form
      class="form"
      id="application-form"
      name="ai-builders-application"
      method="POST"
      data-netlify="true"
      netlify
      netlify-honeypot="company"
      action={FORM_ACTION}
    >
      <input type="hidden" name="form-name" value="ai-builders-application" />
      <p class="hidden" aria-hidden="true">
        <label>Leave this empty: <input name="company" tabindex="-1" autocomplete="off" /></label>
      </p>

      <p class="step-indicator" aria-live="polite">Step <span id="step-current">1</span> of 3 — <span id="step-name">About you</span></p>

      <fieldset class="step" data-step="1">
        <legend>About you</legend>

        <div class="field">
          <label for="app-name">Your name *</label>
          <input id="app-name" type="text" name="name" required placeholder="First and last" autocomplete="name" />
        </div>

        <div class="field">
          <label for="app-email">Email *</label>
          <input id="app-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
        </div>

        <div class="field">
          <label for="app-phone">Phone <span class="optional">(optional — only used if we need to reach you about your application)</span></label>
          <input id="app-phone" type="tel" name="phone" placeholder="Optional" autocomplete="tel" />
        </div>

        <div class="field">
          <label for="app-city">City</label>
          <input id="app-city" type="text" name="city" placeholder="Stockton, Modesto, Lathrop…" autocomplete="address-level2" />
        </div>
      </fieldset>

      <fieldset class="step" data-step="2" hidden>
        <legend>What you're building</legend>

        <div class="field">
          <label for="app-role">What do you do? *</label>
          <select id="app-role" name="role" required>
            <option value="">Pick one…</option>
            <option>Business owner / operator</option>
            <option>Marketing, sales, or customer success</option>
            <option>IT, sysadmin, or technical support</option>
            <option>Developer / engineer</option>
            <option>Healthcare, legal, or finance</option>
            <option>Education, nonprofit, or public sector</option>
            <option>Student or career-changer</option>
            <option>Something else</option>
          </select>
        </div>

        <div class="field">
          <label for="app-building">
            What are you building or running right now? *
            <em class="hint">This is the screening question. Answer honestly — "I'm trying to automate my invoicing" beats "I want to learn AI."</em>
          </label>
          <textarea id="app-building" name="building" rows="4" required placeholder="A few sentences is plenty."></textarea>
        </div>

        <div class="field">
          <label for="app-goal">What would you love to have working by the end of the year? *</label>
          <textarea id="app-goal" name="goal" rows="3" required placeholder="The thing you'd be proud to show someone."></textarea>
        </div>

        <div class="field">
          <label for="app-coding">Your coding comfort *</label>
          <select id="app-coding" name="coding" required>
            <option value="">Pick one…</option>
            <option>None — I've never written code</option>
            <option>A little — I can follow code, not write it</option>
            <option>Comfortable — I write code regularly</option>
            <option>Advanced — I build production systems</option>
          </select>
        </div>
      </fieldset>

      <fieldset class="step" data-step="3" hidden>
        <legend>Final details</legend>

        <div class="field">
          <label for="app-laptop">Do you have a laptop you can install software on?</label>
          <select id="app-laptop" name="laptop">
            <option value="">Pick one…</option>
            <option>Yes — I can install anything</option>
            <option>Browser only — my laptop is locked down</option>
            <option>I'd need to borrow one</option>
          </select>
        </div>

        <div class="field">
          <label for="app-expect">What would make this worth your two hours?</label>
          <textarea id="app-expect" name="expect" rows="3" placeholder="Optional — but it's the most useful box on this form."></textarea>
        </div>

        <div class="field">
          <label for="app-link">Link to something you made (site, GitHub, LinkedIn)</label>
          <input id="app-link" type="url" name="link" placeholder="Optional" />
        </div>

        <div class="check">
          <input id="app-commitment" type="checkbox" name="commitment" required />
          <label for="app-commitment">
            I can commit to <strong>a session a month</strong> and I'll bring
            my own problem to work on.
          </label>
        </div>

        <button type="submit" class="submit">Apply for a seat</button>
        <p class="fineprint">
          We'll email you within a week either way. If we're not a fit, we'll
          tell you — and point you at something better if we know of it.
          By applying you agree to our
          <a href="/code-of-conduct">code of conduct</a> and
          <a href="/privacy">privacy notice</a>.
        </p>
      </fieldset>

      <div class="step-nav">
        <button type="button" class="nav-btn secondary" id="step-back" hidden>Back</button>
        <button type="button" class="nav-btn" id="step-next">Continue</button>
      </div>
    </form>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('application-form');
    if (!form) return;
    var steps = Array.prototype.slice.call(form.querySelectorAll('.step'));
    var back = document.getElementById('step-back');
    var next = document.getElementById('step-next');
    var currentEl = document.getElementById('step-current');
    var nameEl = document.getElementById('step-name');
    var names = ['About you', "What you're building", 'Final details'];
    var current = 0;

    function show(i) {
      current = i;
      steps.forEach(function (s, idx) { s.hidden = idx !== i; });
      back.hidden = i === 0;
      next.hidden = i === steps.length - 1;
      currentEl.textContent = String(i + 1);
      nameEl.textContent = names[i];
      var first = steps[i].querySelector('input, select, textarea');
      if (first) first.focus({ preventScroll: false });
    }
    function stepValid(i) {
      var fields = steps[i].querySelectorAll('input, select, textarea');
      for (var k = 0; k < fields.length; k++) {
        if (!fields[k].checkValidity()) { fields[k].reportValidity(); return false; }
      }
      return true;
    }
    next.addEventListener('click', function () {
      if (stepValid(current) && current < steps.length - 1) show(current + 1);
    });
    back.addEventListener('click', function () {
      if (current > 0) show(current - 1);
    });
    form.addEventListener('submit', function (e) {
      for (var i = 0; i < steps.length; i++) {
        var fields = steps[i].querySelectorAll('input, select, textarea');
        for (var k = 0; k < fields.length; k++) {
          if (!fields[k].checkValidity()) {
            e.preventDefault();
            show(i);
            fields[k].reportValidity();
            return;
          }
        }
      }
    });
  })();
</script>

<style>
  .apply { padding: 70px 0 80px; }
  .apply-head { max-width: 760px; margin-bottom: 40px; }
  h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); font-weight: 800; letter-spacing: -0.02em; }
  .section-sub { color: var(--text-muted); margin: 14px 0 26px; }
  .notes { display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 12px; }
  .note {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 16px 18px;
    color: var(--text-muted); font-size: 0.9rem;
  }
  .note strong { color: var(--accent); }
  .form {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 32px; max-width: 820px;
  }
  .step-indicator { color: var(--text-dim); font-size: 0.88rem; font-weight: 600; margin-bottom: 18px; }
  fieldset.step { border: 0; padding: 0; margin: 0; min-width: 0; }
  fieldset.step legend {
    font-size: 1.15rem; font-weight: 700; margin-bottom: 18px; padding: 0;
  }
  .field { display: block; margin-bottom: 20px; }
  .field label {
    display: block; font-size: 0.88rem; font-weight: 600;
    margin-bottom: 7px; color: var(--text);
  }
  .optional { font-weight: 400; color: var(--text-dim); font-size: 0.82rem; }
  .hint {
    display: block; font-style: normal; font-weight: 400;
    color: var(--text-dim); font-size: 0.82rem; margin-top: 4px;
  }
  input[type='text'], input[type='email'], input[type='tel'], input[type='url'], select, textarea {
    width: 100%; background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 14px; color: var(--text);
    font-family: inherit; font-size: 0.95rem; transition: border-color .15s;
  }
  textarea { resize: vertical; line-height: 1.55; }
  input:focus, select:focus, textarea:focus {
    outline: none; border-color: var(--accent);
  }
  select { cursor: pointer; }
  .check {
    display: flex; gap: 12px; align-items: flex-start;
    margin: 26px 0 22px; font-size: 0.92rem; color: var(--text-muted);
  }
  .check input { margin-top: 3px; accent-color: var(--accent); width: 17px; height: 17px; }
  .check label { cursor: pointer; }
  .check strong { color: var(--text); }
  .submit {
    background: var(--accent); color: #000; border: 0;
    font-weight: 700; font-size: 1rem; padding: 15px 36px;
    border-radius: 999px; cursor: pointer; font-family: inherit;
    transition: background .2s;
  }
  .submit:hover { background: var(--accent-hover); }
  .step-nav { display: flex; gap: 12px; margin-top: 24px; }
  .nav-btn {
    background: var(--accent); color: #000; border: 0;
    font-weight: 700; font-size: 0.95rem; padding: 13px 30px;
    border-radius: 999px; cursor: pointer; font-family: inherit;
    transition: background .2s;
  }
  .nav-btn:hover { background: var(--accent-hover); }
  .nav-btn.secondary {
    background: transparent; color: var(--text);
    border: 1px solid var(--border);
  }
  .nav-btn.secondary:hover { background: var(--bg-card-hover); border-color: var(--accent); }
  .fineprint { color: var(--text-dim); font-size: 0.84rem; margin: 16px 0 0; }
  /* Honeypot: off-screen but not display:none, so bots still fill it. */
  .hidden {
    position: absolute; left: -5000px; top: auto;
    width: 1px; height: 1px; overflow: hidden;
  }
  @media (max-width: 640px) {
    .form { padding: 22px; }
  }
</style>
