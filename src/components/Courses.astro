---
// The curriculum renders from src/data/curriculum.mjs — the single
// source the track pages, cohort calendar, guide PDF, and .ics files
// also read. Copy below is the site's published copy, verbatim.
import { quarters, projects } from '../data/curriculum.mjs';
export interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
---

<section class="curriculum" id="curriculum">
  <div class="container">
    <h2>{es ? 'Las 24 sesiones' : 'The 24 sessions'}</h2>
    <p class="section-sub">
      {es
        ? 'Una vez al mes al principio; dos veces al mes cuando el grupo se consolide. El recorrido empieza en «¿qué es la IA?» y termina contigo presentando un sistema que construiste y que ya está en producción.'
        : 'Monthly to start, twice monthly once the room holds. The arc starts at "what even is AI" and ends with you presenting a shipped system you built.'}
    </p>

    {quarters.map((q) => (
      <div class="quarter">
        <div class="quarter-head">
          <span class="q-label">{q.label}</span>
          <h3>{q.title}</h3>
          <p>{q.blurb}</p>
        </div>
        <ol class="sessions">
          {q.sessions.map((s) => (
            <li class="session">
              <span class="s-num mono">{String(s.n).padStart(2, '0')}</span>
              <div class="s-body">
                <h4>{s.title}</h4>
                <p class="s-concept">{s.concept}</p>
              </div>
              <div class="s-artifact">
                <span class="s-artifact-label">{es ? 'Te llevas' : 'You leave with'}</span>
                <span class="s-artifact-text">{s.artifact}</span>
              </div>
            </li>
          ))}
        </ol>
      </div>
    ))}

    <div class="projects">
      <h3>{es ? 'Ocho proyectos de portafolio' : 'Eight portfolio projects'}</h3>
      <p>
        {es
          ? 'Cada uno tiene un nivel técnico y un nivel de negocio — y un número. Nada de impresiones. Estos son los artefactos que van a tu LinkedIn y frente a un cliente.'
          : 'Each one has a technical bar and a business bar — plus a number. No vibes. These are the artifacts that go on your LinkedIn and in front of a client.'}
      </p>
      <div class="project-grid">
        {projects.map((p) => (
          <div class="project"><strong>{p.name}</strong><span>{p.bar}</span></div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .curriculum { padding: 70px 0 40px; }
  h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); font-weight: 800; letter-spacing: -0.02em; }
  .section-sub { color: var(--text-muted); margin: 14px 0 46px; max-width: 640px; }
  .quarter { margin-bottom: 54px; }
  .quarter-head { margin-bottom: 18px; }
  .q-label {
    color: var(--accent); font-size: 0.78rem; font-weight: 700;
    text-transform: uppercase; letter-spacing: 0.1em;
  }
  .quarter-head h3 { font-size: 1.45rem; font-weight: 700; margin: 6px 0 6px; }
  .quarter-head p { color: var(--text-muted); margin: 0; font-size: 0.97rem; }
  .sessions { list-style: none; padding: 0; margin: 0; }
  .session {
    display: grid; grid-template-columns: 52px 1fr 260px; gap: 20px;
    align-items: center; padding: 16px 20px;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); margin-bottom: 8px;
    transition: border-color .15s, background .15s;
  }
  .session:hover { border-color: var(--border-accent); background: var(--bg-card-hover); }
  .s-num {
    color: var(--accent); font-weight: 700; font-size: 1.05rem;
    font-variant-numeric: tabular-nums;
  }
  .s-body h4 { font-size: 1rem; font-weight: 700; margin: 0 0 3px; }
  .s-concept { color: var(--text-dim); font-size: 0.88rem; margin: 0; }
  .s-artifact { text-align: right; }
  .s-artifact-label {
    display: block; color: var(--text-dim); font-size: 0.7rem;
    text-transform: uppercase; letter-spacing: 0.08em; font-weight: 600;
  }
  .s-artifact-text { color: var(--text-muted); font-size: 0.87rem; }
  .projects { margin-top: 70px; padding-top: 46px; border-top: 1px solid var(--border); }
  .projects h3 { font-size: 1.5rem; font-weight: 700; margin: 0 0 10px; }
  .projects > p { color: var(--text-muted); margin: 0 0 26px; max-width: 620px; }
  .project-grid {
    display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 12px;
  }
  .project {
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 18px 20px;
  }
  .project strong { display: block; font-size: 0.97rem; margin-bottom: 5px; }
  .project span { color: var(--text-dim); font-size: 0.86rem; }
  @media (max-width: 800px) {
    .session { grid-template-columns: 40px 1fr; }
    .s-artifact { grid-column: 2; text-align: left; }
  }
</style>
