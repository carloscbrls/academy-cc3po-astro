---
// 1-field Curriculum Guide capture. Same backend as the application form:
// Netlify Forms (see Newsletter.astro). Submissions land in the Netlify
// dashboard under the "curriculum-guide" form.
---

<section class="guide">
  <div class="container">
    <div class="guide-card">
      <div class="guide-copy">
        <h2>Get the Curriculum Guide</h2>
        <p>
          All 24 sessions and the 8 portfolio projects, in one short guide.
          Leave your email and we'll send it over — no list, no spam.
        </p>
      </div>
      <form
        class="guide-form"
        name="curriculum-guide"
        method="POST"
        data-netlify="true"
        netlify
        netlify-honeypot="company"
        action="/success"
      >
        <input type="hidden" name="form-name" value="curriculum-guide" />
        <p class="hidden" aria-hidden="true">
          <label>Leave this empty: <input name="company" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="guide-row">
          <div class="guide-field">
            <label for="guide-email">Email</label>
            <input id="guide-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
          </div>
          <button type="submit" class="guide-submit">Send me the guide</button>
        </div>
      </form>
    </div>
  </div>
</section>

<style>
  .guide { padding: 10px 0 20px; }
  .guide-card {
    display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: center;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 30px;
  }
  .guide-copy h2 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 8px; }
  .guide-copy p { color: var(--text-muted); font-size: 0.95rem; margin: 0; }
  .guide-row { display: flex; gap: 12px; align-items: flex-end; }
  .guide-field { flex: 1; }
  .guide-field label {
    display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 7px;
  }
  .guide-field input {
    width: 100%; background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 14px; color: var(--text);
    font-family: inherit; font-size: 0.95rem;
  }
  .guide-field input:focus { outline: none; border-color: var(--accent); }
  .guide-submit {
    background: var(--accent); color: #000; border: 0; font-weight: 700;
    font-size: 0.95rem; padding: 13px 24px; border-radius: 999px;
    cursor: pointer; font-family: inherit; white-space: nowrap;
  }
  .guide-submit:hover { background: var(--accent-hover); }
  .hidden {
    position: absolute; left: -5000px; top: auto;
    width: 1px; height: 1px; overflow: hidden;
  }
  @media (max-width: 800px) {
    .guide-card { grid-template-columns: 1fr; }
    .guide-row { flex-direction: column; align-items: stretch; }
  }
</style>
