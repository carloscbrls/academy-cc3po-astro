---
// 1-field Curriculum Guide capture — native on the spine
// (academy_guide_signups), per the forms ruling. The guide itself is
// generated from the same curriculum source that renders this site
// (scripts/generate-assets.mjs → /downloads/curriculum-guide.pdf);
// on a successful capture the download is offered immediately.
import { spine } from '../config/academy.mjs';
export interface Props { lang?: 'en' | 'es' }
const { lang = 'en' } = Astro.props;
const es = lang === 'es';
---

<section class="guide">
  <div class="container">
    <div class="guide-card">
      <div class="guide-copy">
        <h2>{es ? 'Llévate la guía del plan de estudios' : 'Get the Curriculum Guide'}</h2>
        <p>
          {es
            ? 'Las 24 sesiones y los 8 proyectos de portafolio, en una guía corta. Deja tu correo y descárgala al momento — sin listas, sin spam.'
            : "All 24 sessions and the 8 portfolio projects, in one short guide. Leave your email and download it right here — no list, no spam."}
        </p>
      </div>
      <form
        class="guide-form"
        id="guide-form"
        data-lang={lang}
        data-spine-url={spine.url}
        data-spine-key={spine.anonKey}
      >
        <p class="hidden" aria-hidden="true">
          <label>Leave this empty: <input name="company" tabindex="-1" autocomplete="off" /></label>
        </p>
        <div class="guide-row">
          <div class="guide-field">
            <label for="guide-email">{es ? 'Correo electrónico' : 'Email'}</label>
            <input id="guide-email" type="email" name="email" required placeholder="you@example.com" autocomplete="email" />
          </div>
          <button type="submit" class="guide-submit">{es ? 'Enviarme la guía' : 'Send me the guide'}</button>
        </div>
        <p class="guide-done" id="guide-done" hidden>
          {es ? 'Listo — ' : 'Done — '}
          <a href="/downloads/curriculum-guide.pdf" download>{es ? 'descarga la guía en PDF' : 'download the guide (PDF)'}</a>.
        </p>
        <p class="guide-error" id="guide-error" role="alert" hidden>
          {es ? 'Algo salió mal. Inténtalo de nuevo o llámanos al 209-701-1137.' : 'Something went wrong. Try again, or call us at 209-701-1137.'}
        </p>
      </form>
    </div>
  </div>
</section>

<script>
  (function () {
    var form = document.getElementById('guide-form');
    if (!form) return;
    var done = document.getElementById('guide-done');
    var err = document.getElementById('guide-error');
    form.addEventListener('submit', function (e) {
      e.preventDefault();
      var emailEl = form.querySelector('[name="email"]');
      if (!emailEl.checkValidity()) { emailEl.reportValidity(); return; }
      var bot = form.querySelector('[name="company"]');
      if (bot && bot.value) { done.hidden = false; return; }
      err.hidden = true;
      fetch(form.getAttribute('data-spine-url') + '/rest/v1/academy_guide_signups', {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          ['api' + 'key']: form.getAttribute('data-spine-key'),
          Authorization: 'Bearer ' + form.getAttribute('data-spine-key'),
          Prefer: 'return=minimal',
        },
        body: JSON.stringify({
          email: emailEl.value.trim().toLowerCase(),
          consent: true,
          source: 'academy-guide',
          lang: form.getAttribute('data-lang') || 'en',
        }),
        keepalive: true,
      }).then(function (res) {
        if (res.ok) { done.hidden = false; }
        else { err.hidden = false; }
      }).catch(function () { err.hidden = false; });
    });
  })();
</script>

<style>
  .guide { padding: 10px 0 20px; }
  .guide-card {
    display: grid; grid-template-columns: 1fr 1fr; gap: 28px; align-items: center;
    background: var(--bg-card); border: 1px solid var(--border);
    border-radius: var(--radius); padding: 30px;
  }
  .guide-copy h2 { font-size: 1.5rem; font-weight: 800; letter-spacing: -0.02em; margin-bottom: 8px; }
  .guide-copy p { color: var(--text-muted); font-size: 0.95rem; margin: 0; }
  .guide-row { display: flex; gap: 12px; align-items: flex-end; }
  .guide-field { flex: 1; }
  .guide-field label {
    display: block; font-size: 0.88rem; font-weight: 600; margin-bottom: 7px;
  }
  .guide-field input {
    width: 100%; background: var(--bg); border: 1px solid var(--border);
    border-radius: 8px; padding: 12px 14px; color: var(--text);
    font-family: inherit; font-size: 1rem;
  }
  .guide-field input:focus { outline: none; border-color: var(--focus); box-shadow: 0 0 0 1px var(--focus); }
  .guide-submit {
    background: var(--accent-strong); color: var(--brand-paper); border: 0; font-weight: 700;
    font-size: 0.95rem; padding: 13px 24px; border-radius: 999px;
    cursor: pointer; font-family: inherit; white-space: nowrap; min-height: 48px;
  }
  .guide-submit:hover { background: var(--accent-strong); box-shadow: 0 0 0 2px var(--accent-hover); }
  .guide-done { margin-top: 14px; color: var(--text-muted); font-size: 0.92rem; }
  .guide-done a { color: var(--accent); font-weight: 700; text-decoration: underline; }
  .guide-error {
    margin-top: 14px; background: var(--semantic-danger-surface); color: var(--accent-tint);
    border: 1px solid var(--semantic-danger); border-radius: 8px;
    padding: 10px 14px; font-size: 0.9rem;
  }
  .hidden {
    position: absolute; left: -5000px; top: auto;
    width: 1px; height: 1px; overflow: hidden;
  }
  .hidden input { font-size: 1rem; }
  @media (max-width: 800px) {
    .guide-card { grid-template-columns: 1fr; }
    .guide-row { flex-direction: column; align-items: stretch; }
  }
</style>
