---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import { projects } from '../data/curriculum.mjs';
import { monthLabel } from '../config/academy.mjs';
const demoMonth = monthLabel(24);
---
<Base title="Demo Day" description="Demo Day is Session 24 of the CC3PO AI Builders Lab: the founding cohort presents the systems they shipped. The outcomes wall fills with the first cohort's work.">
  <Nav />
  <main id="main-content">
    <section class="dd-hero">
      <div class="container">
        <span class="kicker mono">Session 24 · Capstone + Demo Day</span>
        <h1>The room shows its work.</h1>
        <p class="intro">
          Demo Day is the last session of the program — {demoMonth}, at the end of
          the founding cohort's run. Every member presents a live project and a
          case study: what it does, what it cost, where it breaks. No slideware.
          If it doesn't run, it doesn't present.
        </p>
        <div class="cta-row">
          <a class="cta" href="/apply">Apply for Cohort 1</a>
          <a class="cta secondary" href="/cohort">See the calendar</a>
        </div>
      </div>
    </section>

    <section class="wall">
      <div class="container">
        <h2>The outcomes wall</h2>
        <p class="wall-note">
          This wall is honest-empty on purpose. The first cohort hasn't run yet,
          so there are no results to show — and we don't invent testimonials.
          After Demo Day, this is where the founding cohort's shipped systems
          live: the artifact, the numbers, and the person who built it.
        </p>
        <div class="wall-grid">
          {projects.map((p) => (
            <div class="slot">
              <strong>{p.name}</strong>
              <span>{p.bar}</span>
              <em>Founding cohort — {demoMonth}</em>
            </div>
          ))}
        </div>
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .dd-hero { padding: 70px 0 30px; }
  .kicker { color: var(--accent); font-size: 0.78rem; font-weight: 700; letter-spacing: 0.1em; text-transform: uppercase; }
  h1 { font-size: clamp(2rem, 4.6vw, 3.2rem); font-weight: 800; letter-spacing: -0.02em; margin: 14px 0 16px; }
  .intro { color: var(--text-muted); font-size: 1.08rem; max-width: 680px; line-height: 1.65; }
  .cta-row { margin-top: 28px; display: flex; gap: 14px; flex-wrap: wrap; }
  .cta {
    display: inline-block; background: var(--accent-strong); color: var(--brand-paper); font-weight: 700;
    padding: 13px 28px; border-radius: 999px; font-size: 0.98rem;
  }
  .cta:hover { background: var(--accent-strong); box-shadow: 0 0 0 2px var(--accent-hover); }
  .cta.secondary { background: transparent; color: var(--text); border: 1px solid var(--border); }
  .cta.secondary:hover { background: var(--bg-card-hover); border-color: var(--border-accent); }
  .wall { padding: 40px 0 80px; }
  .wall h2 { font-size: clamp(1.6rem, 3.6vw, 2.3rem); font-weight: 800; letter-spacing: -0.02em; }
  .wall-note { color: var(--text-muted); max-width: 700px; margin: 12px 0 30px; line-height: 1.65; }
  .wall-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 12px; }
  .slot {
    background: var(--bg-card); border: 1px dashed var(--border);
    border-radius: var(--radius); padding: 20px;
  }
  .slot strong { display: block; font-size: 0.97rem; margin-bottom: 5px; }
  .slot span { display: block; color: var(--text-dim); font-size: 0.86rem; margin-bottom: 10px; }
  .slot em { color: var(--accent); font-size: 0.78rem; font-style: normal; font-weight: 600; text-transform: uppercase; letter-spacing: 0.06em; }
</style>
