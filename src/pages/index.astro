---
import Base from '../layouts/Base.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import GuideCapture from '../components/GuideCapture.astro';
import Fork from '../components/Fork.astro';
import Courses from '../components/Courses.astro';
import Faq from '../components/Faq.astro';
import Footer from '../components/Footer.astro';

const courseJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Course',
  name: 'CC3PO AI Builders — Applied AI & Automation Lab',
  description:
    'A former Tesla Vision engineer teaches Stockton how to build real AI systems. Free, monthly to start, from first principles to shipped systems. 24 sessions over 12 months, 8 portfolio projects.',
  provider: {
    '@type': 'Organization',
    name: 'CC3PO LLC',
    sameAs: 'https://cc3po.com',
  },
  hasCourseInstance: {
    '@type': 'CourseInstance',
    courseMode: 'onsite',
    courseWorkload: 'P12M',
    location: {
      '@type': 'Place',
      name: 'Stockton, California',
      address: { '@type': 'PostalAddress', addressLocality: 'Stockton', addressRegion: 'CA', addressCountry: 'US' },
    },
  },
  offers: {
    '@type': 'Offer',
    price: '0',
    priceCurrency: 'USD',
    category: 'Free',
  },
};
---
<Base title="CC3PO AI Builders" description="A former Tesla Vision engineer teaches Stockton how to build real AI systems. Free, monthly to start, from first principles to shipped systems." jsonLd={courseJsonLd}>
  <Nav />
  <main id="main-content">
    <Hero />
    <GuideCapture />
    <Fork />
    <Courses />
    <Faq />
    <section class="apply-teaser" id="apply">
      <div class="container">
        <h2>Apply for a seat</h2>
        <p>
          Twenty seats. Applications are read by a human. We want people who are
          building or running something — not people collecting certificates.
        </p>
        <a class="cta" href="/apply">Apply in 2 Minutes</a>
        <a class="cta secondary" href="/cohort">See the cohort calendar</a>
      </div>
    </section>
  </main>
  <Footer />
</Base>
<style>
  .apply-teaser { padding: 20px 0 80px; }
  .apply-teaser h2 { font-size: clamp(1.9rem, 4vw, 2.7rem); font-weight: 800; letter-spacing: -0.02em; }
  .apply-teaser p { color: var(--text-muted); margin: 14px 0 26px; max-width: 640px; }
  .cta {
    display: inline-block; background: var(--accent-strong); color: var(--brand-paper); font-weight: 700;
    padding: 14px 32px; border-radius: 999px; font-size: 1rem; margin-right: 12px;
  }
  .cta:hover { background: var(--accent-strong); box-shadow: 0 0 0 2px var(--accent-hover); }
  .cta.secondary { background: transparent; color: var(--text); border: 1px solid var(--border); }
  .cta.secondary:hover { background: var(--bg-card-hover); border-color: var(--border-accent); }
</style>
